# Obtain from @BotFather. Never commit the real value.
BOT_TOKEN=
# MongoDB Atlas connection string
MONGODB_URI=
# Comma-separated numeric Telegram user IDs allowed to bootstrap the bot.
# These owners can add other administrators from /admin.
OWNER_IDS=
# Public URL assigned by Render, e.g. https://my-bot.onrender.com
WEBHOOK_URL=
# Any long random path segment used by Telegram webhook mode
WEBHOOK_SECRET=
# Render supplies PORT automatically; local default is 3000.
PORT=3000
